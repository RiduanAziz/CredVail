# ==============================================================================
# CREDVAIL — Environment Configuration Blueprint (.env.example)
# Do NOT commit sensitive keys or actual credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credvail?schema=public"

# Session Security & Encryption (Generate via `openssl rand -hex 32`)
SESSION_SECRET="credvail_super_secret_session_encryption_key_32bytes_minimum"
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Tenant Master Key Encryption (KMS / Envelope AES-256-GCM Master Key)
# REQUIRED in production. Must be a canonical 32-byte Base64-encoded string (44 chars ending with '=').
# Generate via: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Cryptographically independent of SESSION_SECRET. Fails closed if missing or malformed.
KMS_MASTER_KEY=

# Blockchain Configuration (Ethereum Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DEPLOYER_PRIVATE_KEY=""

# Object Storage Configuration (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="credvail-credentials"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public DID & Issuer Settings
NEXT_PUBLIC_DID_DOMAIN="credvail.io"
CHALLENGE_TTL_SECONDS=300
